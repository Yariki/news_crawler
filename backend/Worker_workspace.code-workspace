{
	"folders": [
		{
			"name": "backend",
			"path": "."
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		"python.testing.cwd": "${workspaceFolder}",
		"python.testing.pytestArgs": [
			"tests"
		],
		"python.testing.unittestEnabled": false,
		"python.testing.pytestEnabled": true,
		"workbench.colorCustomizations": {
			"activityBar.activeBackground": "#bf4ae4",
			"activityBar.background": "#bf4ae4",
			"activityBar.foreground": "#e7e7e7",
			"activityBar.inactiveForeground": "#e7e7e799",
			"activityBarBadge.background": "#e2ba3d",
			"activityBarBadge.foreground": "#15202b",
			"commandCenter.border": "#e7e7e799",
			"sash.hoverBorder": "#bf4ae4",
			"statusBar.background": "#ae21da",
			"statusBar.foreground": "#e7e7e7",
			"statusBarItem.hoverBackground": "#bf4ae4",
			"statusBarItem.remoteBackground": "#ddb122",
			"statusBarItem.remoteForeground": "#e7e7e7",
			"titleBar.activeBackground": "#ae21da",
			"titleBar.activeForeground": "#e7e7e7",
			"titleBar.inactiveBackground": "#ae21da99",
			"titleBar.inactiveForeground": "#e7e7e799",
			"tab.hoverBackground": "#d1d1d1",
			"tab.activeForeground": "#e7e7e7",
			"activityBarTop.activeBackground": "#bf4ae4",
			"activityBarTop.background": "#bf4ae4",
			"activityBarTop.foreground": "#e7e7e7",
			"activityBarTop.inactiveForeground": "#e7e7e799",
			"commandCenter.foreground": "#e7e7e7",
			"statusBar.debuggingBackground": "#ae21da",
			"statusBar.debuggingForeground": "#e7e7e7",
			"activityBar.activeBorder": "#e7e7e7",
			"activityBarTop.activeBorder": "#e7e7e7"
		},
		"peacock.color": "#ae21da",
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/__pycache__": true,
			"**/dist": true,
			"**/build": true,
			"**/news_crawler.egg-info": true
		},
		"docwriter.style": "Auto-detect",
		"chat.tools.terminal.autoApprove": {
			"/^python -m compileall -q app/utils/normalization && python -c \"import inspect; from app\\.utils\\.normalization\\.normalization_result import NormalizationResult; print\\(inspect\\.signature\\(NormalizationResult\\)\\)\"$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^python -c \"import inspect; from app\\.utils\\.normalization\\.normalization_result import NormalizationResult; print\\(inspect\\.signature\\(NormalizationResult\\)\\); NormalizationResult\\('raw', 'normalized', 'normalized', \\[\\], \\['tag'\\], \\['mention'\\], 1\\)\"$/": {
				"approve": true,
				"matchCommandLine": true
			}
		}
	}
}